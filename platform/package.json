{
  "name": "kuvona-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Academia Kuvona — plataforma real de cursos (loja, estudante, instrutor e gestão).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e.mts",
    "test:studio": "tsx scripts/studio-e2e.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db.ts migrate",
    "db:seed": "tsx --conditions=react-server scripts/db.ts seed",
    "db:seed-catalog": "tsx --conditions=react-server scripts/db.ts seed-catalog",
    "db:reset": "tsx --conditions=react-server scripts/db.ts reset",
    "create-admin": "tsx --conditions=react-server scripts/db.ts create-admin",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@vercel/functions": "^3.10.4",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
