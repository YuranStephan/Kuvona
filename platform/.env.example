# Copia para .env.local e ajusta. Nunca faças commit de segredos.

# URL pública da aplicação (links em emails, certificados e verificação).
APP_URL=http://localhost:3100

# Base de dados. Sem DATABASE_URL, usa PostgreSQL embutido (PGlite) em .data/pglite.
# Em produção (Vercel), usa a connection string do Supabase (pooler, porta 6543).
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-xx.pooler.supabase.com:6543/postgres

# Email. Sem RESEND_API_KEY, os emails ficam na caixa de saída interna (Gestão → Emails).
# RESEND_API_KEY=
# EMAIL_FROM="Academia Kuvona <nao-responder@exemplo.co.mz>"

# Simulador de pagamentos (apenas desenvolvimento). Fica desligado em produção.
# KUVONA_ENABLE_SANDBOX=1
# Segredo para assinar eventos do simulador (gerado automaticamente em desenvolvimento).
# PAYMENT_WEBHOOK_SECRET=

# Primeira conta de gestão em produção: npm run create-admin -- email@exemplo.com "Nome"
